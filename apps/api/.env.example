# ---------------------------------------------------------------------------
# The Hill Trekkers Club — API environment template
# Copy to `.env` and fill in real values. In production set ENVIRONMENT=production
# and provide real secrets — the app refuses to boot otherwise.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
APP_BASE_URL=http://localhost:3000
PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL connection string. Use a managed Postgres in production.
DATABASE_URL=postgresql://postgres:devon@localhost:5432/hill_trekkers_club

# JWT — generate a strong random value, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=dev-secret-6f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c
JWT_EXPIRES_MINUTES=10080

# Paystack — use sk_test_/pk_test_ keys during integration, sk_live_/pk_live_ at launch.
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# Cloudinary (required in production; local-disk uploads are dev-only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_UPLOAD_DIR=uploads

# Email — Resend API key. Leave blank to log emails to stdout (dev only).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=hello@hilltrekkersclub.com

# Operations
LOG_LEVEL=INFO
DB_POOL_MIN=2
DB_POOL_MAX=10
